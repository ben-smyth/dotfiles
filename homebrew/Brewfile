# Shared Homebrew packages for every machine.
#
# Rule of thumb:
#   - Command-line tools go in nix/modules/home/packages.nix (nixpkgs).
#   - Machine-specific casks, App Store apps and odd formulae go in
#     homebrew/<host>.Brewfile.
#   - Apps that update themselves and are already installed (for example
#     carried over by Migration Assistant) can stay unmanaged.
#
# Apply with nix/scripts/update_system.sh, which runs `brew bundle --global`
# against the ~/.Brewfile that Home Manager builds from these files.

# Take over apps that already exist in /Applications instead of failing with
# "already an App".
cask_args adopt: true

brew "mas"
