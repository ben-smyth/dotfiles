# Work MacBook Pro.
#
# Installed outside Homebrew and self-updating (reinstall by hand on a fresh
# Mac): Google Chrome, 1Password, Docker Desktop, Spotify, Obsidian,
# Sublime Text, Ice, Swish, OpenWebStart, XQuartz.

# Keg-only, so it does not clash with the Nix-provided Java on PATH.
brew "openjdk"

# Provides `op`; the 1Password app itself is installed outside Homebrew.
cask "1password-cli"
